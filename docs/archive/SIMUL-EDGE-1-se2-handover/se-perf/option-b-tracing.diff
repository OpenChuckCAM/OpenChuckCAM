+    fn kept_within(&self) -> f64 {
+        static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        if !*ON.get_or_init(|| std::env::var("OCC_FIT_INSIDE").is_ok()) {
+            return self.tolerance;
+        }
+        let stated = self.input.surface.tool_gap_accuracy();
+        if stated > 0.0 {
+            self.tolerance - stated.min(0.25 * LAYER * self.allowed)
+        } else {
+            self.tolerance
+        }
+    }
