diff --git a/crates/openchuck-path/src/brep.rs b/crates/openchuck-path/src/brep.rs
index a6a5f1c..61ecdef 100644
--- a/crates/openchuck-path/src/brep.rs
+++ b/crates/openchuck-path/src/brep.rs
@@ -2451,6 +2451,33 @@ impl BrepSurface {
             target,
             self.deflection,
         );
+        if let Ok(path) = std::env::var("OCC_DUMP_MESH") {
+            use std::io::Write as _;
+            let mut out = Vec::new();
+            out.extend_from_slice(&[0u8; 80]);
+            out.extend_from_slice(&(r.mesh.triangles.len() as u32).to_le_bytes());
+            for i in 0..r.mesh.triangles.len() {
+                out.extend_from_slice(&[0u8; 12]);
+                if let Some(t) = r.mesh.triangle(i) {
+                    for q in t {
+                        for v in [q.x, q.y, q.z] {
+                            out.extend_from_slice(&(v as f32).to_le_bytes());
+                        }
+                    }
+                }
+                out.extend_from_slice(&[0u8; 2]);
+            }
+            let _ = std::fs::write(&path, out);
+            // exact vertices and errors as text
+            let mut text = String::new();
+            for i in 0..r.mesh.triangles.len() {
+                if let Some(t) = r.mesh.triangle(i) {
+                    text.push_str(&format!("{:?} {:?} {:?} {:?} {:?} {:?} {:?} {:?} {:?} {:?}\n", t[0].x, t[0].y, t[0].z, t[1].x, t[1].y, t[1].z, t[2].x, t[2].y, t[2].z, r.errors.get(i).copied().unwrap_or(0.0)));
+                }
+            }
+            let _ = std::fs::File::create(format!("{path}.txt")).and_then(|mut f| f.write_all(text.as_bytes()));
+            eprintln!("DUMPED target {target} triangles {} largest {}", r.mesh.triangles.len(), r.largest);
+        }
         let surface = MeshSurface::new(&r.mesh).ok()?;
         let made = std::sync::Arc::new((r, surface));
         kept.push((key, std::sync::Arc::clone(&made)));
